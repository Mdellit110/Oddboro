# A young park tree, one tile. A small lobed canopy on a thin trunk, for
# the edge of a grove or a gap between the big ones. Same variants as
# park-tree.
sprite park-tree-small
size 16 32
layer object
footprint 1 1
origin 0 16
tag tree plant park
variant autumn v=y V=Y !=9 J=8
variant dark v=V V=! !=J J=7

frame default
