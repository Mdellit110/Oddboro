# A snack vending machine, two tiles wide. The case light is on and the
# buy button glows coral.
sprite break-vending
size 32 48
layer object
footprint 2 1
origin 0 32
tag vending snacks clear-1
light 11 6 26 #fff0c2 0.5

frame default
