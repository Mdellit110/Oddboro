# A long oak lunch table for four, with a placemat per seat. Staff sit along
# the north side facing the room; put a kitchen-chair on each seat tile.
sprite kitchen-table
size 64 26
layer object
footprint 4 1
origin 0 10
tag table kitchen eat
spot seat-0 0 -1 down eat sit
spot seat-1 1 -1 down eat sit
spot seat-2 2 -1 down eat sit
spot seat-3 3 -1 down eat sit
variant walnut o=w O=W 1=3 2=3
variant ash o=a O=A 1=4 2=4

