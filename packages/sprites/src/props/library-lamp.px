# A small reading lamp: linen shade on a brass stem. Sits on the side table;
# the origin drops its foot onto the table top.
sprite library-lamp
size 16 22
layer object
footprint 1 1
origin 0 26
walkable
zbias 1
tag lamp light library
light 8 8 40 #ffd27a 1.0

frame default
