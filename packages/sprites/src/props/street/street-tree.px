# A street tree in an iron grate, two tiles wide. Round canopy, lit from the
# upper left, with a few pale clumps. The autumn variant turns it amber.
sprite street-tree
size 32 48
layer object
footprint 2 1
origin 0 32
tag tree plant street
variant autumn v=y V=Y !=9
variant rust v=r V=R !=8

frame default
